# Use the Jellyfin address reachable FROM the companion container.
# Historical server address: http://192.168.68.107:8097 — verify before deploying.
JELLYFIN_URL=http://192.168.68.107:8097
JELLYFIN_API_KEY=replace_me
ALLERFLUX_API_KEY=generate_a_long_random_secret
ALLERFLUX_WEBHOOK_KEY=generate_a_different_long_random_secret
DATABASE_URL=sqlite:////data/allerflux.db
POLL_INTERVAL_SECONDS=20
IDLE_ALERT_THRESHOLD_SECONDS=1800
ALERT_COOLDOWN_MINUTES=60
# Optional outbound JSON webhook (ntfy/custom receiver). Leave blank to keep alerts in-app only.
ALERT_WEBHOOK_URL=
