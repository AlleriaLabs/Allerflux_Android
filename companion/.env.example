# Jellyfin server URL reachable from this container, e.g. http://192.168.68.107:8097
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace_with_jellyfin_api_key
ALLERFLUX_API_KEY=replace_with_a_long_random_secret
# Generate once with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep stable across restarts and backups; losing it prevents credential decryption.
ALLERFLUX_ENCRYPTION_KEY=replace_with_url_safe_base64_32_byte_key
DATABASE_URL=sqlite:////data/allerflux.db
POLL_INTERVAL_SECONDS=20
